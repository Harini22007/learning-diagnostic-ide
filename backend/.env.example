# =========================================================
# AI Study Weakness Detector - Backend Environment Variables
# =========================================================

# LLM API Keys (Provide at least one)
# ---------------------------------------------------------
# Option 1: Google Gemini (Recommended)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
# ---------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# Development / Offline Mock Mode (true / false)
# Set to true if you want to test the entire pipeline without calling an LLM API
MOCK_LLM=false
